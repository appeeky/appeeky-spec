{
  "name": "@appeeky/spec",
  "version": "0.4.0",
  "description": "Your app's store listing as a spec: lint it, check keyword coverage, diff it against the live store and push it to App Store Connect and Google Play.",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "bin": {
    "appeeky-spec": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "skills",
    "agents",
    ".github/assets/cover.gif",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appeeky/appeeky-spec.git"
  },
  "homepage": "https://spec.appeeky.com",
  "bugs": {
    "url": "https://github.com/appeeky/appeeky-spec/issues"
  },
  "keywords": [
    "aso",
    "app-store-optimization",
    "app-store",
    "app-store-connect",
    "google-play",
    "metadata",
    "keywords",
    "spec",
    "cli",
    "appeeky"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"for (const f of ['ugc-core.js','visibility-core.js']) require('fs').copyFileSync('vendor/'+f,'dist/'+f)\"",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "pack:check": "npm run build && npm pack --dry-run",
    "release:dry": "node scripts/release.mjs --dry-run",
    "vendor:ugc": "node scripts/vendor-ugc-core.mjs",
    "vendor:visibility": "node scripts/vendor-visibility-core.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "^13.1.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
