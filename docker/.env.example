# The app's spec repo, and a fine-grained token for it: Repository access "Only select
# repositories" → this repo, permission Contents: Read and write (Pull requests: Read
# and write too for the weekly agent).
REPO_URL=https://github.com/you/your-app.git
GITHUB_TOKEN=
# Store access, analytics and AI Visibility: appeeky.com/dashboard/settings
APPEEKY_API_KEY=

# Optional
# BRANCH=main
# SPEC_DIR=.                       # the folder with appeeky.spec.yaml
# DAILY_AT=0 6 * * *               # UTC
# PUSH_EVERY=*/15 * * * *          # "off" to push by hand
# The weekly agent: use the latest-agent image and one of these.
# WEEKLY_AT=0 7 * * 1
# CLAUDE_CODE_OAUTH_TOKEN=         # run `claude setup-token` on your computer: uses your Claude Pro or Max plan
# ANTHROPIC_API_KEY=               # or pay per use
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid   # pinged after every daily run, /fail when it fails
# PUSH_DRY_RUN=1                   # show what a push would change, change nothing
# FAL_KEY=                         # render UGC clips here on your own fal account (ugc generate --local) instead of Appeeky credits
# Your own keys for the daily routine:
# GSC_CREDENTIALS=                 # Google Search Console: a service account JSON key (or its path) → seo pull
# ASA_CLIENT_ID=                   # Apple Search Ads API user (Account Settings → API) → search-ads pull
# ASA_TEAM_ID=
# ASA_KEY_ID=
# ASA_PRIVATE_KEY=                 # the EC private key PEM (or its path)
# DATAFORSEO_LOGIN=                # DataForSEO API access → seo ranks (Google positions, AI Overviews)
# DATAFORSEO_PASSWORD=
# SEO_RANKS_EVERY=7                # days between rank checks
# VISIBILITY_EVERY=7               # ask the AI assistants every 7 days on your keys (visibility scan --local):
# OPENAI_API_KEY=                  #   ChatGPT
# GEMINI_API_KEY=                  #   Gemini
# PERPLEXITY_API_KEY=              #   Perplexity (ANTHROPIC_API_KEY above adds Claude)
