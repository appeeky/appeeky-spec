# The app's spec repo, and a fine-grained token for it: Repository access "Only select
# repositories" → this repo, permission Contents: Read and write (Pull requests: Read
# and write too for the weekly agent).
REPO_URL=https://github.com/you/your-app.git
GITHUB_TOKEN=
# Store access, analytics and AI Visibility: appeeky.com/dashboard/settings
APPEEKY_API_KEY=

# Optional
# BRANCH=main
# SPEC_DIR=.                       # the folder with appeeky.spec.yaml
# DAILY_AT=0 6 * * *               # UTC
# PUSH_EVERY=*/15 * * * *          # "off" to push by hand
# The weekly agent: use the latest-agent image and one of these.
# WEEKLY_AT=0 7 * * 1
# CLAUDE_CODE_OAUTH_TOKEN=         # run `claude setup-token` on your computer: uses your Claude Pro or Max plan
# ANTHROPIC_API_KEY=               # or pay per use
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid   # pinged after every daily run, /fail when it fails
# PUSH_DRY_RUN=1                   # show what a push would change, change nothing
